#!/bin/sh
# Patch BTServer's launchd plist to force-load our dylib (MobileSubstrate won't
# inject the daemon on iOS 6). Never abort dpkg on failure — a failed patch just
# means no daemon injection, which is harmless.

TOOL=/usr/libexec/airpodsreconnectfix/aprfctl
PL=/System/Library/LaunchDaemons/com.apple.BTServer.plist
LOG=/var/mobile/AirPodsReconnectFix.log

echo "$(date) [postinst] running; remounting / rw and patching" >> "$LOG" 2>/dev/null
# /System lives on the root partition, which may be mounted read-only at runtime.
/sbin/mount -u -o rw / 2>/dev/null || mount -u -o rw / 2>/dev/null || true

if [ -x "$TOOL" ]; then
    "$TOOL" install || echo "$(date) [postinst] aprfctl install returned $?" >> "$LOG" 2>/dev/null
    chmod 644 "$PL" 2>/dev/null || true
    chown root:wheel "$PL" 2>/dev/null || true
else
    echo "$(date) [postinst] tool missing at $TOOL" >> "$LOG" 2>/dev/null
fi

echo "==================================================================="
echo " AirPodsReconnectFix: BTServer.plist patch attempted."
echo " REBOOT the device for it to take effect."
echo " (Backup at /Library/AirPodsReconnectFix/BTServer.plist.orig;"
echo "  uninstalling restores it automatically. Check the log at"
echo "  /var/mobile/AirPodsReconnectFix.log for the patch result.)"
echo "==================================================================="
exit 0
