#!/bin/sh
# v2.7.2: SpringBoard-only tweak. Only thing postinst still has to do is run
# `aprfctl uninstall` once to scrub any leftover env-var keys 2.5.x/2.6.x added
# to BTServer.plist on first install (idempotent — no-op if there's nothing to
# strip). We DO NOT unload/load BTServer anymore: that bricks Bluetooth until
# reboot if `load` doesn't bring it back cleanly, and there's nothing in the
# plist for the daemon to re-read either.

TOOL=/usr/libexec/airpodsreconnectfix/aprfctl
LOG=/var/mobile/AirPodsReconnectFix.log

echo "$(date) [postinst] v2.7.2 — SpringBoard-only build, scrubbing any legacy BTServer.plist edits" >> "$LOG" 2>/dev/null
/sbin/mount -u -o rw / 2>/dev/null || mount -u -o rw / 2>/dev/null || true

if [ -x "$TOOL" ]; then
    "$TOOL" uninstall || echo "$(date) [postinst] aprfctl uninstall returned $?" >> "$LOG" 2>/dev/null
fi

echo "AirPodsReconnectFix 2.7.2 installed. Respring to activate."
exit 0
